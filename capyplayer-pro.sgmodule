#!name=CapyPlayer Pro 解锁
#!desc=让 CapyPlayer 认为当前账号是终身 Pro。只改写订阅状态响应，不动其他请求。
#!system=ios

[Script]
capyplayer-pro-status = type=http-response, pattern=^https://api-capyplayer\.feifeiduck\.cn/api/v1/subscriptions/status, requires-body=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/ssssbbbbg/surge-rules/main/capy_sub.js

capyplayer-pro-status-q = type=http-response, pattern=^https://api-capyplayer\.feifeiduck\.cn/api/v1/subscriptions/status\?, requires-body=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/ssssbbbbg/surge-rules/main/capy_sub.js

[MITM]
hostname = %APPEND% api-capyplayer.feifeiduck.cn
